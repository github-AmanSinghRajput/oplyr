{
  "name": "@oplyr/runtime",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:pack": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-pack/server.mjs --external:better-sqlite3 --external:@xenova/transformers --external:node-pty --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "db:migrate": "node --import tsx src/scripts/db-migrate.ts",
    "db:ready": "node --import tsx src/scripts/db-ready.ts",
    "test": "node --import tsx --test $(find src -name '*.test.ts' -print)"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "node-pty": "^1.1.0",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.8.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
